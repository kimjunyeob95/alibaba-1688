                    },
                    "meta": {
                        "properties": {
                            "timestamp": {
                                "type": "string",
                                "example": "2023-12-19 17:45:50"
                            },
                            "api_type": {
                                "type": "string",
                                "example": "mall"
                            }
                        },
                        "type": "object"
                    },
                    "error": {
                        "properties": {
                            "code": {
                                "type": "integer",
                                "example": 500
                            },
                            "message": {
                                "type": "string",
                                "example": "Too many requests"
                            }
                        },
                        "type": "object"
                    }
                },
                "type": "object"
            },
            "TokenCreateSchema": {
                "required": [
                    "user_id"
                ],
                "properties": {
                    "user_id": {
                        "type": "string",
                        "example": "bonaera"
                    }
                },
                "type": "object"
            },
            "SuccessTokenResponse": {
                "properties": {
                    "status": {
                        "type": "integer",
                        "example": 200
                    },
                    "meta": {
                        "properties": {
                            "timestamp": {
                                "type": "string",
                                "example": "2023-12-19 17:45:50"
                            },
                            "api_type": {
                                "type": "string",
                                "example": "mall"
                            }
                        },
                        "type": "object"
                    },
                    "msg": {
                        "type": "string",
                        "example": "정상 처리 되었습니다."
                    },
                    "data": {
                        "properties": {
                            "token": {
                                "type": "string",
                                "example": "eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9..."
                            },
                            "expiresAt": {
                                "type": "string",
                                "example": "2023-12-19 18:45:50"
                            }
                        },
                        "type": "object"
                    }
                },
                "type": "object"
            },
            "InUpdateSchema": {
                "required": [
                    "type",
                    "stock_no"
                ],
                "properties": {
                    "type": {
                        "description": "코드 타입 IT001: 입고 상태의 변경, IT002: 입고 정보 변경",
                        "type": "string",
                        "example": "IT001"
                    },
                    "stock_no": {
                        "description": "재고번호",
                        "type": "string",
                        "example": "ST241014000198"
                    }
                },
                "type": "object"
            },
            "OutUpdateSchema": {
                "required": [
                    "type",
                    "group_no",
                    "sh_nos"
                ],
                "properties": {
                    "type": {
                        "description": "코드 타입 SH001: 출고 상태의 변경, SH002: 출고 정보의 변경",
                        "type": "string",
                        "example": "SH001"
                    },
                    "group_no": {
                        "description": "그룹번호",
                        "type": "string",
                        "example": "GR241015000381"
                    },
                    "sh_nos": {
                        "description": "신청서 번호 리스트",
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "example": [
                            "SH241015000381",
                            "SH241015000382"
                        ]
                    }
                },
                "type": "object"
            },
            "DeliveryBundleSchema": {
                "required": [
                    "type",
                    "sh_no",
                    "origin_group_no",
                    "change_group_no"
                ],
                "properties": {
                    "type": {
                        "description": "코드 타입 GR003: 묶음 배송변경",
                        "type": "string",
                        "example": "GR003"
                    },
                    "sh_no": {
                        "description": "출고 번호",
                        "type": "string",
                        "example": "SH241114001737"
                    },
                    "origin_group_no": {
                        "description": "원본 배송 번호",
                        "type": "string",
                        "example": "GR241114001730"
                    },
                    "change_group_no": {
                        "description": "변경 배송 번호",
                        "type": "string",
                        "example": "GR241114001731"
                    }
                },
                "type": "object"
            },
            "DeliveryUpdateSchema": {
                "required": [
                    "type",
                    "group_no",
                    "sh_nos"
                ],
                "properties": {
                    "type": {
                        "description": "코드 타입 GR001: 배송 상태의 변경, GR002: 배송 정보의 변경",
                        "type": "string",
                        "example": "GR001"
                    },
                    "group_no": {
                        "description": "그룹번호",
                        "type": "string",
                        "example": "GR241015000381"
                    },
                    "sh_nos": {
                        "description": "신청서 번호 리스트",
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "example": [
                            "SH241015000381",
                            "SH241015000382"
                        ]
                    }
                },
                "type": "object"
            }
        },
        "securitySchemes": {
            "BearerAuth": {
                "type": "http",
                "bearerFormat": "JWT",
                "scheme": "bearer"
            }
        }
    }
}