                            }
                        },
                        "type": "object"
                    }
                },
                "type": "object"
            },
            "404ErrorResponse": {
                "properties": {
                    "status": {
                        "type": "integer",
                        "example": 404
                    },
                    "meta": {
                        "properties": {
                            "timestamp": {
                                "type": "string",
                                "example": "2023-12-19 17:45:50"
                            },
                            "api_type": {
                                "type": "string",
                                "example": "mall"
                            }
                        },
                        "type": "object"
                    },
                    "error": {
                        "properties": {
                            "code": {
                                "type": "integer",
                                "example": 404
                            },
                            "message": {
                                "type": "string",
                                "example": "잘못된 접근입니다."
                            }
                        },
                        "type": "object"
                    }
                },
